APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_CREDENTIALS=storage/app/firebase/firebase_credentials.json
FIREBASE_CREDENTIALS_BASE64=
GOOGLE_APPLICATION_CREDENTIALS=
# Valores seguros por defecto. Render se valida en una fase posterior y estos
# flags no deben habilitarse sin una ventana controlada de staging.
# El contrato admite solo data-only, entrega individual, textos genéricos y
# prohíbe notification block, topics, multicast y datos identificables/clínicos.
FCM_ENABLED=false
FCM_DRY_RUN=true
FCM_DEFAULT_CHANNEL_ID=rehabianex_reminders
FCM_DEFAULT_ANDROID_PRIORITY=high
FCM_SAFE_PUBLIC_TITLE=Rehabianex
FCM_SAFE_PUBLIC_BODY="Tienes una actualización en Rehabianex."
FCM_CRITICAL_ALERTS_ENABLED=false
FCM_ADMIN_NOTIFICATIONS_ENABLED=false
FCM_SUPERVISOR_CLINICAL_ALERTS_ENABLED=false
FCM_VULNERABLE_PRIORITY_ENABLED=false
# Política declarativa para el fallback Android básico; no habilita envíos
# locales desde Laravel ni permite alertas clínicas fuera de FCM.
FCM_OFFLINE_FALLBACK_ALLOWED=true
GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=

# Solo para crear el primer admin sin prompt; retirar después de usar.
REHABIANEX_ADMIN_PASSWORD=

AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=google/gemini-flash-1.5
AI_APP_NAME=RehabiAnex
AI_SITE_URL=http://127.0.0.1:8000
